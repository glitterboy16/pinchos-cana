# Backend de la carta (opcional para ver la web, necesario para editarla).
# Sin estas dos variables la carta se muestra igual con los datos de
# src/data/carta.js, pero el acceso del propietario no funciona.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Fila de `site_content` donde vive esta carta. Cámbiala si compartes el
# proyecto de Supabase con otro restaurante.
VITE_CONTENT_KEY=carta_pinchos_cana

# Dominio ficticio del login: el dueño escribe solo "admin".
VITE_ADMIN_DOMAIN=acceso.pinchoscana.local

# Dirección pública de la web. Solo hace falta si el QR debe apuntar a un
# dominio distinto del que sirve la página (por defecto usa el suyo propio).
VITE_SITE_URL=
